<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.kodi.ke-client" name="Karaoke Eternal Client" version="1.0.0" provider-name="theCrazylegs">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <!-- Service qui tourne en arrière-plan -->
    <extension point="xbmc.service" library="service.py" start="startup"/>

    <!-- Permet d'ouvrir les settings via le menu Kodi -->
    <extension point="xbmc.python.script" library="service.py">
        <provides>executable</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Native Kodi client for Karaoke Eternal</summary>
        <summary lang="fr_FR">Client Kodi natif pour Karaoke Eternal</summary>
        <description lang="en_GB">Displays a dynamic waiting screen and manages the karaoke flow from your Karaoke Eternal server.</description>
        <description lang="fr_FR">Affiche un écran d'attente dynamique et gère le flux karaoké depuis votre serveur Karaoke Eternal.</description>
        <platform>all</platform>
        <license>MIT</license>
        <website>https://github.com/theCrazylegs/karaoke-eternal</website>
        <source>https://github.com/theCrazylegs/karaoke-eternal</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>